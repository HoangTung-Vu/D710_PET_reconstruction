#!/usr/bin/env bash
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$HERE/apptainer_shim/setup.sh"

CMD="${1:-}"
case "$CMD" in
    doctor) _apt_doctor; exit $? ;;
    ""|-h|--help|help)
        cat <<'USAGE'
d710_apptainer -- exactly `./d710`, with apptainer instead of docker.

  ./d710_apptainer doctor                        check this machine first
  ./d710_apptainer exam --raw D --ct D --case N  everything else: ./d710 --help

This is the workstation's entry point. Only two commands need a container at
all -- `decode` and `estimate`, both inside d710:full -- and everything after
them runs on the host in the petct_recon conda environment, through
PyTomography and parallelproj. There is no SIRF on this path and no second
image to carry around.

A WRAPPER, NOT A COPY. `d710` holds the pipeline logic -- the TOF switch that
must reach both decode and estimate, the numeric bed sort, the per-bed SINO
lookup, the interpreter probing -- and a second copy would begin to diverge at
the first edit. This script therefore changes only the two things apptainer
changes, then runs the real `d710`:

  1. the image name becomes the .sif path (D710_IMAGE);
  2. apptainer_shim/ goes first on $PATH, so that every `docker` in the tree --
     d710's own, and equally vendor/run.sh's and utils/container.py's, which
     this script never touches -- is the shim and becomes `apptainer exec`.

WHAT RUNS WHERE
  decode tostir read shell   apptainer and the d710 .sif; nothing else.
  simulate gate              apptainer and a SECOND .sif, d710:gate: the
                             opengate wheels need glibc >= 2.34 and this host
                             has 2.31, so Geant4 runs in a container while the
                             conversion afterwards stays on the host.  Build it
                             with simulation/gate/Dockerfile (instructions in
                             the file, and in the error if it is missing).
  simulate phantom|pp|compare   no container: conda activate petct_recon.
  estimate                   the same, plus --fakeroot, because GE's pet_recon
                             opens /usr/PET/systemConfig/cmcfg.xml read-write
                             and docker ran that step as root. `doctor` checks
                             it; apptainer_shim/docker prints the fallback if
                             it is missing.
  attn lm lowdose export     no container: conda activate petct_recon. This is
                             where a GPU pays off.
  osem                       not here. The sinogram path still needs SIRF and
                             is kept for comparison only, on a machine with
                             docker: ./d710_isolate_stir.sh osem --case N

THE GPU. The shim adds --nv whenever /dev/nvidiactl exists, but nothing inside
d710:full uses it: pet_recon's GPU path is forced off in vendor/boot.gdb, GE
never having shipped the .cl kernels. The GPU is worth having for the host
half -- `d710 attn --device cuda` and `d710 lm` -- which needs a CUDA torch and
a cuda* build of libparallelproj in petct_recon. `doctor` reports both.

BUILDING THE .sif FILE, on the machine holding the docker image:
  apptainer build d710_full.sif docker-daemon://d710:full
Then declare it once in D710/.env:
  D710_SIF=/path/to/d710_full.sif
Without that line it is looked for in $D710_SIF_DIR, D710/sif/, D710/,
$D710_OUT/sif and ~/sif.

ADDITIONAL ENVIRONMENT, beyond everything ./d710 --help lists:
  D710_SIF                 the image
  D710_GATE_SIF            the GATE image, for `simulate gate`
  D710_GATE_RUNNER         how to start Geant4, if the default
                           `apptainer exec --bind ... <sif> python` is wrong
  D710_SIF_DIR             where to look for it
  D710_APPTAINER_BIN       the apptainer binary, if not on $PATH
  D710_APPTAINER_FAKEROOT  1 / 0 / auto           (see apptainer_shim/docker)
  D710_APPTAINER_OVERLAY   tmpfs / none / <dir>   the writable layer
  D710_APPTAINER_NV        1 / 0 / auto
  D710_APPTAINER_BIND      additional binds, space-separated
  D710_APPTAINER_QUIET     1 to stop echoing every apptainer command
USAGE
        echo
        echo "================ ./d710 --help ================"
        exec "$HERE/d710" --help
        ;;
    decode|estimate|tostir|exam|read|shell)
        _apt_need "d710:full" "${D710_SIF:-}" D710_SIF ;;
    simulate)
        # Only the Geant4 half needs a container, and only `simulate gate`
        # starts it.  phantom, pp and compare are host python.
        [[ "${2:-}" == gate ]] && _apt_need_gate ;;
    osem)
        echo ">> note: 'osem' is the sinogram path and still needs SIRF, which" >&2
        echo ">>       is not on this machine.  It is kept for comparison only:" >&2
        echo ">>       ./d710_isolate_stir.sh osem --case ...  (needs docker)" >&2
        ;;
esac

exec "$HERE/d710" "$@"
