#!/usr/bin/env bash
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

ENV_FILE="${D710_ENV_FILE:-$HERE/.env}"
if [[ -f "$ENV_FILE" ]]; then
    while IFS='=' read -r k v; do
        k="${k#"${k%%[![:space:]]*}"}"
        [[ "$k" == export[[:space:]]* ]] && k="${k#export}"
        k="${k//[[:space:]]/}"
        [[ "$k" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
        [[ -v "$k" ]] && continue
        v="${v%$'\r'}"; v="${v%%[[:space:]]#*}"
        v="${v#"${v%%[![:space:]]*}"}"
        v="${v%"${v##*[![:space:]]}"}"
        [[ "$v" == \"*\" || "$v" == \'*\' ]] && v="${v:1:${#v}-2}"
        [[ "$v" == '~/'* ]] && v="$HOME${v:1}"
        export "$k=$v"
    done < "$ENV_FILE"
fi

IMAGE="${D710_IMAGE:-d710:full}"
PY="${D710_PYTHON:-python3}"

export D710_IMAGE="$IMAGE"

die() { echo "error: $*" >&2; exit 2; }
usage() {
    cat <<'USAGE'
d710 -- the single entry point of the GE Discovery 710 reconstruction pipeline.

COMMANDS
  d710 decode   --raw D --case N [--tof]         RDF -> Interfile, all beds
                [--listmode --lists D [--format npy|petsird]]  plus the event table
  d710 estimate --raw D --ct D --case N [--bed n] [--tof]  GE kernel -> .f32
  d710 tostir   --case N [--bed n]               .f32 -> STIR Interfile
  d710 exam     --raw D --ct D --case N          decode + estimate + tostir
                [--listmode --lists D]           forwarded to decode, so one
                                                 exam feeds both paths
  d710 attn     --case N                         CT -> work/bed<n>/attn.hs
  d710 osem     --case N [--beds ...] [--iters]  OSEM and bed stitching
  d710 lm       check|tofcheck|recon --case N    list-mode OSEM (PyTomography)
                recon accepts --resume, as osem does
  d710 lowdose  --case N --drf D                 a thinned copy of a case
                [--mode low-count|low-dose]      shorter scan / less activity
                [--sinogram derived|binomial]    -> <case>/raw_simulation/
  d710 export   --case N [--format nifti|dicom] [--lm]
                                                 Bq/mL and SUV -> NIfTI/DICOM
                                                 --lm reads recon_lm.npz
  d710 read     <file.f32>                       read one vendor dump
  d710 shell    [--case N]                       a shell inside the container

THREE RUNTIMES, KEPT SEPARATE
  d710:full        decode estimate tostir exam read shell -- GE's own software
  sirf-local:0.1   attn osem export -- run through ./d710_isolate_stir.sh
  host python      lm lowdose -- PyTomography and parallelproj; no SIRF

Nothing in lm/ or lowdose/ imports sirf or stir. See lm/README.md and
lowdose/README.md.

ONE IMAGE GRID FOR BOTH
The two SIRF builds disagree about the meaning of --xy: sirf-local fixes the
FOV at 718.01 mm and scales the voxel, while the host build fixes the voxel at
2.1306 mm and scales the FOV. utils/scanner.py holds every geometric and
machine constant, and its XY = 337 is the one matrix size giving 2.130600 mm in
both. Anything built on the earlier 256 grid must be rerun.

TIME OF FLIGHT
  --tof            enable TOF (decode mashing to 5 bins, estimate reconMethod 3)
  --tof-mash N     implies --tof and changes the mash factor (N must divide 55)
  --no-tof         the default, spelled out for clarity

TOF is off by default on the sinogram path because of its cost on this machine,
not because it is unsupported. Measured 2026-08-27, ped bed 1, parallelproj,
16 cores, no GPU:

  non-TOF                          ~2 min/bed
  TOF 5 bins,  grid 128            9.6 min/bed
  TOF 5 bins,  grid 337 (default)  ~48 min/bed
  TOF 11 bins, grid 337            ~1.6 h/bed

This applies to the sinogram path only. `d710 lm` pays nothing for TOF: each
event's ray is truncated to +-3 sigma about its own TOF position and is
therefore shorter than the full chord. Measured on ped bed 1, grid 337, 2x24,
TOF at all 55 bins takes 2 m 01 s per bed against 2 m 39 s non-TOF.

Because 55 = 5 x 11, the only mash factors are 1, 5, 11 and 55:

  mash  bins  RAM for OSEM  effective TOF resolution   SNR benefit retained
     1   55        40 GB      681 ps = 102 mm                     100 %
     5   11         8 GB      809 ps = 121 mm                      92 %
    11    5       3.6 GB     1191 ps = 179 mm                      76 %

Keeping all 55 bins is not feasible here: OSEM needs prompts, background and
sensitivity simultaneously in float32, about 40 GB, and this machine has 30 GB.

One switch drives both decode and estimate, deliberately: TOF prompts combined
with non-TOF scatter make OSEM fall back silently to an improvised profile.

The TOF axis was mirrored until 2026-08-29. Anything decoded before that date
must be decoded again: counts, file size and every invariant are identical
either way and only the image differs. TOF headers now carry a `; TOF axis`
line, and utils.terms.load refuses prompts that lack it. Re-run
`d710 decode --tof --force` and then `d710 tostir`; both take seconds.

OUTPUT LOCATION
  --out  >  $D710_OUT  >  error. There is deliberately no default, so that
  output never lands inside the source tree.

    export D710_OUT=~/UET/d710_out
    d710 exam --raw <petRDFS dir> --ct <CT series dir> --case ped

The d710:full image is delivered as-is and never rebuilt
(`docker load -i d710_full.tar`), so there is no `d710 build`. The Dockerfile
here only records the image contents; rebuilding requires the 18 GB
custom_tool/petsw/ tree, which is not in the repository. The D710/ code is not
baked into the image but mounted at run time, so code edits take effect
immediately.

ENVIRONMENT VARIABLES
All may also be set in D710/.env; copy .env.example and edit it.
  D710_OUT     root of the output tree
  D710_IMAGE   image name (default d710:full)
  D710_CASE    default case name for --case
  D710_PYTHON  interpreter for osem and export (default python3)
USAGE
}

resolve_out() {
    local o="${OUT:-${D710_OUT:-}}"
    [[ -n "$o" ]] || die "no idea where to write the output.
  set   export D710_OUT=~/UET/d710_out
  or pass  --out <directory>
  (deliberately no default: output must never land inside the source tree)"
    o="${o/#\~/$HOME}"
    mkdir -p "$o"
    (cd "$o" && pwd)
}

need_case() { [[ -n "${CASE:-}" ]] || die "--case is required (or set \$D710_CASE)"; }

need_image() {
    docker image inspect "$IMAGE" >/dev/null 2>&1 || die "no image '$IMAGE'.
  the image is handed over as-is, never rebuilt:
      docker load -i d710_full.tar
  (D710/Dockerfile records what the image contains.)
  it keeps whatever name the tar was saved with -- if that is not '$IMAGE',
  check \`docker images\` and put the real name in D710/.env:
      D710_IMAGE=<name:tag>
  or, for one run:  D710_IMAGE=<name:tag> d710 $CMD ..."
}

py_candidates() {
    local seen=""
    if [[ -n "${D710_PYTHON:-}" ]]; then echo "$D710_PYTHON"; return; fi
    local c
    for c in python3 python \
             "${VIRTUAL_ENV:+$VIRTUAL_ENV/bin/python}" \
             "${CONDA_PREFIX:+$CONDA_PREFIX/bin/python}" \
             /usr/bin/python3 /usr/local/bin/python3; do
        [[ -n "$c" ]] || continue
        case " $seen " in *" $c "*) continue ;; esac
        seen="$seen $c"
        echo "$c"
    done
}

resolve_py() {
    local c
    for c in $(py_candidates); do
        command -v "$c" >/dev/null 2>&1 || continue
        "$c" -c 'import sys; raise SystemExit(0 if sys.version_info[:2] >= (3, 8) else 1)' \
            2>/dev/null && { echo "$c"; return 0; }
    done
    return 1
}

need_py() {
    local mods="$1" what="$2" env="${3:-petct_recon}" c
    if [[ -n "${D710_PYTHON:-}" ]]; then
        "$D710_PYTHON" -c "import ${mods}" 2>/dev/null && { PY="$D710_PYTHON"; return; }
    else
        for c in $(py_candidates); do
            command -v "$c" >/dev/null 2>&1 || continue
            if "$c" -c "import ${mods}" 2>/dev/null; then PY="$c"; return; fi
        done
    fi
    die "no interpreter here can import: ${mods}
  tried: $(py_candidates | tr '\n' ' ')
  ${what}
      conda activate ${env}
  or point straight at one that can:
      export D710_PYTHON=/path/to/python
  (only \`osem\`, \`attn\`, \`export\`, \`lm\` and \`lowdose\` need more than the
  standard library; decode/estimate/tostir/exam run on any python3.)"
}

need_sirf() {
    need_py "numpy, sirf.STIR" \
        "SIRF/STIR only loads once the env is ACTIVATED -- the interpreter path
  alone is not enough, the loader needs the env's LD_LIBRARY_PATH too.
  Normally you do not need this at all: ./d710_isolate_stir.sh runs osem/attn/
  export in the sirf-local image instead." \
        petct_reconstruction
}

need_export_py() {
    need_py "numpy, nibabel, pydicom" "The project environment is required:"
}

if [[ -z "${D710_PYTHON:-}" ]]; then
    PY="$(resolve_py)" || die "no working Python 3 found on this machine.
  tried: $(py_candidates | tr '\n' ' ')
  install one, or point at it:  export D710_PYTHON=/path/to/python"
fi

drun() { docker run --rm -i --user "$(id -u):$(id -g)" -e HOME=/tmp "$@"; }

beds=()
beds_from() {
    local dir="$1" pat="$2" strip="$3" p b
    beds=()
    shopt -s nullglob
    for p in "$dir"/$pat; do
        b="$(basename "$p" "$strip")"
        beds+=("${b#bed}")
    done
    shopt -u nullglob
    [[ ${#beds[@]} -gt 0 ]] || return 0
    mapfile -t beds < <(printf '%s\n' "${beds[@]}" | sort -n)
}

sino_for_bed() {
    local dec="$1" n="$2"
    "$PY" - "$dec/bed$n.json" <<'PY'
import json, sys
print(json.load(open(sys.argv[1]))["path"].rsplit("/", 1)[-1])
PY
}

CMD="${1:-}"; shift || true
case "$CMD" in ""|-h|--help|help) usage; exit $([[ -z "$CMD" ]] && echo 2 || echo 0) ;; esac

RAW=""; CT=""; LISTS=""; CASE="${D710_CASE:-}"; OUT=""; BED=""
FORCE=0; LISTMODE=0; TOF_ON=0; MASH=5; FORMAT=""; REST=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --raw)      RAW="$2"; shift 2 ;;
    --ct)       CT="$2"; shift 2 ;;
    --lists)    LISTS="$2"; shift 2 ;;
    --case)     CASE="$2"; shift 2 ;;
    -o|--out)   OUT="$2"; shift 2 ;;
    --bed)      BED="$2"; shift 2 ;;
    --format)   FORMAT="$2"; shift 2 ;;
    --listmode) LISTMODE=1; shift ;;
    --tof)      TOF_ON=1; shift ;;
    --no-tof|--collapse-tof) TOF_ON=0; shift ;;
    --tof-mash) TOF_ON=1; MASH="$2"; shift 2 ;;
    --force)    FORCE=1; shift ;;
    -h|--help)  usage; exit 0 ;;
    *)          REST+=("$1"); shift ;;
  esac
done

if (( TOF_ON )); then
    TOF=""; TOF_MASH="--tof-mash $MASH"; NO_TOF=""
else
    TOF="--collapse-tof"; TOF_MASH=""; NO_TOF="--no-tof"
fi

case "$CMD" in

decode)
    need_case; need_image
    [[ -n "$RAW" ]] || die "--raw is required"
    [[ -d "$RAW" ]] || die "no such raw directory: $RAW"
    O="$(resolve_out)"; DEC="$O/$CASE/decoded"
    mkdir -p "$DEC"
    RAW="$(cd "$RAW" && pwd)"

    mounts=(-v "$RAW:/raw:ro" -v "$DEC:/out" -v "$HERE/decode:/decode:ro")
    if (( LISTMODE )); then
        [[ -n "$LISTS" ]] || die "--listmode needs --lists <petLists directory>"
        [[ -d "$LISTS" ]] || die "no such lists directory: $LISTS"
        mounts+=(-v "$(cd "$LISTS" && pwd):/lists:ro")
    fi
    drun "${mounts[@]}" "$IMAGE" bash /decode/decode_in.sh \
         "$LISTMODE" "$FORCE" "$TOF $TOF_MASH" "${FORMAT:-npy}"
    exit $?
    ;;

estimate)
    need_case; need_image
    [[ -n "$RAW" && -n "$CT" ]] || die "--raw and --ct are both required"
    [[ -d "$RAW" ]] || die "no such raw directory: $RAW"
    [[ -d "$CT"  ]] || die "no such CT directory: $CT"
    O="$(resolve_out)"; DEC="$O/$CASE/decoded"
    [[ -d "$DEC" ]] || die "case $CASE has not been decoded; run: d710 decode --raw ... --case $CASE"

    if [[ -n "$BED" ]]; then beds=("$BED"); else beds_from "$DEC" 'bed*.hs' .hs; fi
    [[ ${#beds[@]} -gt 0 ]] || die "no bed found in $DEC"

    rc=0
    for n in "${beds[@]}"; do
        VOUT="$O/$CASE/vendor/bed$n"
        done_=1
        for f in randoms.f32 scatter.f32 normdt.f32 norm_only.f32 \
                 prompts.u16 singles.i32 dt_int.f32 dt_mux.f32 \
                 $( ((TOF_ON)) && echo scatter_tof.f32 ); do
            [[ -f "$VOUT/$f" ]] || { done_=0; break; }
        done
        if (( ! FORCE )) && (( done_ )); then
            echo "=== bed $n: $VOUT already complete -- skipping"; continue
        fi
        sino="$(sino_for_bed "$DEC" "$n")"
        echo "=============== bed $n  <- $sino ==============="
        PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" \
            "$PY" "$HERE/vendor/estimate.py" \
                --raw "$RAW/$sino" --ct "$CT" --out "$VOUT" $NO_TOF \
                || { rc=1; echo "  !! bed $n failed" >&2; }
    done
    exit "$rc"
    ;;

tostir)
    need_case; need_image
    O="$(resolve_out)"; DEC="$O/$CASE/decoded"
    if [[ -n "$BED" ]]; then beds=("$BED"); else beds_from "$O/$CASE/vendor" 'bed*' ''; fi
    [[ ${#beds[@]} -gt 0 ]] || die "no estimated bed found in $O/$CASE/vendor"

    rc=0
    for n in "${beds[@]}"; do
        echo "=============== tostir bed $n ==============="
        drun -e PYTHONPATH=/d710 \
             -v "$HERE:/d710:ro" -v "$O/$CASE:/case" "$IMAGE" \
             python3 /d710/vendor/to_stir.py \
                --vendor "/case/vendor/bed$n" \
                --template "/case/decoded/bed$n.hs" \
                --out "/case/work/bed$n" || { rc=1; echo "  !! bed $n failed" >&2; }
    done
    exit "$rc"
    ;;

exam)
    need_case
    [[ -n "$RAW" && -n "$CT" ]] || die "--raw, --ct and --case are all required"
    args=(--case "$CASE"); [[ -n "$OUT" ]] && args+=(--out "$OUT")
    (( FORCE )) && args+=(--force)
    if (( TOF_ON )); then args+=(--tof-mash "$MASH"); else args+=(--no-tof); fi
    dec=(--raw "$RAW")
    if (( LISTMODE )); then
        [[ -n "$LISTS" ]] || die "--listmode needs --lists <petLists directory>"
        dec+=(--listmode --lists "$LISTS")
        [[ -n "$FORMAT" ]] && dec+=(--format "$FORMAT")
    fi
    echo "=============== step 1: decode every bed ==============="
    "$HERE/d710" decode "${args[@]}" "${dec[@]}"
    echo
    echo "=============== step 2: GE's kernel ==============="
    "$HERE/d710" estimate "${args[@]}" --raw "$RAW" --ct "$CT"
    echo
    echo "=============== step 3: -> STIR Interfile ==============="
    "$HERE/d710" tostir "${args[@]}"
    echo
    echo "done.  next:  d710 osem --case $CASE"
    ;;

osem)
    need_case; need_sirf
    O="$(resolve_out)"
    exec env D710_OUT="$O" PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" \
        "$PY" -u -m osem --case "$CASE" \
        ${BED:+--beds "$BED"} ${CT:+--ct "$CT"} "${REST[@]+"${REST[@]}"}"
    ;;

attn)
    need_case; need_sirf
    O="$(resolve_out)"
    exec env D710_OUT="$O" PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" \
        "$PY" -u -m utils.attn_main --case "$CASE" \
        ${BED:+--beds "$BED"} ${CT:+--ct "$CT"} $( ((FORCE)) && echo --force ) \
        "${REST[@]+"${REST[@]}"}"
    ;;

lm)
    need_case; need_py "numpy, torch, pytomography" \
        "PyTomography is required (SIRF is NOT -- see lm/README.md):"
    O="$(resolve_out)"
    exec env D710_OUT="$O" PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" \
        "$PY" -u -m lm "${REST[@]+"${REST[@]}"}" --case "$CASE" \
        ${BED:+--bed "$BED"} ${CT:+--ct "$CT"}
    ;;

lowdose)
    need_case; need_py "numpy" "numpy is required:"
    O="$(resolve_out)"
    exec env D710_OUT="$O" PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" \
        "$PY" -u -m lowdose --case "$CASE" "${REST[@]+"${REST[@]}"}"
    ;;

export)
    need_case; need_export_py
    O="$(resolve_out)"
    exec env D710_OUT="$O" PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" \
        "$PY" -u -m utils.export --case "$CASE" \
        ${FORMAT:+--format "$FORMAT"} "${REST[@]+"${REST[@]}"}"
    ;;

read)
    need_image
    [[ ${#REST[@]} -gt 0 ]] || die "a file is required, e.g.: d710 read \$D710_OUT/ped/vendor/bed6/scatter.f32"
    f="$(cd "$(dirname "${REST[0]}")" && pwd)/$(basename "${REST[0]}")"
    drun -v "$(dirname "$f"):/data:ro" -v "$HERE:/d710:ro" "$IMAGE" \
        python3 /d710/vendor/read_out.py "/data/$(basename "$f")" "${REST[@]:1}"
    exit $?
    ;;

shell)
    need_image
    mounts=(-v "$HERE:/d710:ro" -v "$HERE/vendor:/vendor:ro")
    if [[ -n "$CASE" ]]; then
        O="$(resolve_out)"; mkdir -p "$O/$CASE"
        mounts+=(-v "$O/$CASE:/case")
        echo ">> case $CASE mounted at /case" >&2
    fi
    exec docker run --rm -it --user "$(id -u):$(id -g)" -e HOME=/tmp \
        -e PYTHONPATH=/opt/custom_tool:/d710 \
        --cap-add=SYS_PTRACE --security-opt seccomp=unconfined \
        --add-host CT85_OC0:127.0.0.1 --add-host CT85_OC1:127.0.0.1 \
        --add-host loghost:127.0.0.1  --add-host bay85ct:127.0.0.1 \
        --add-host bay87ct:127.0.0.1  --add-host trec:127.0.0.1 \
        "${mounts[@]}" "$IMAGE" bash
    ;;

*)
    echo "unknown command: $CMD" >&2; echo >&2; usage >&2; exit 2 ;;
esac
