#!/usr/bin/env bash
# d710 -- điểm vào DUY NHẤT của pipeline tái tạo GE Discovery 710.
#
#   d710 decode   --raw D --case N [...]           RDF -> Interfile, mọi bed
#   d710 estimate --raw D --ct D --case N [--bed n]  kernel GE -> .f32
#   d710 tostir   --case N [--bed n]               .f32 -> Interfile STIR
#   d710 exam     --raw D --ct D --case N          = decode + estimate + tostir
#   d710 osem     --case N [--beds ...] [--iters]  OSEM + ghép bed
#   d710 export   --case N [--format nifti|dicom]  Bq/mL + SUV -> NIfTI/DICOM
#   d710 read     <file.f32>                       đọc một dump của vendor
#   d710 shell    [--case N]                       shell trong container
#
# ĐẦU RA đi đâu:  --out  >  $D710_OUT  >  LỖI.
# Cố ý không có mặc định — đầu ra không bao giờ được rơi vào cây mã.
#
#   export D710_OUT=~/UET/d710_out
#   d710 exam --raw ~/Documents/11082026/petRDFS/NQLHQWPU/SYQGRVWD/QONDOBON \
#             --ct  ~/Documents/11082026/PESI/p1/e1/s2 --case ped
#
# IMAGE `d710:full` được BÀN GIAO NGUYÊN CON, không dựng lại:
#   docker load -i d710_full.tar
# Nên không có `d710 build`. Dockerfile ở đây chỉ để ghi lại image chứa gì —
# dựng lại nó cần cây custom_tool/petsw/ 18 GB không nằm trong repo. Mã của
# D710/ KHÔNG bake vào image mà mount lúc chạy, nên sửa mã là có hiệu lực ngay.
#
# CHẠY Ở ĐÂU
#   decode, tostir, read   -> trong container (chỉ cần bash + docker)
#   estimate               -> host điều phối bằng python3 TRẦN, mọi bước con
#                             trong container
#   osem, export           -> host, cần môi trường project (SIRF):
#                             conda activate petct_reconstruction
#
# Biến môi trường:
#   D710_OUT     gốc cây đầu ra
#   D710_IMAGE   tên image (mặc định d710:full)
#   D710_CASE    tên ca mặc định cho --case
#   D710_PYTHON  interpreter cho osem/export (mặc định python3)
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMAGE="${D710_IMAGE:-d710:full}"
PY="${D710_PYTHON:-python3}"

die() { echo "error: $*" >&2; exit 2; }
usage() {
    # Cả khối chú thích đầu file, tới dòng đầu tiên không phải chú thích.
    awk 'NR==1 {next} /^#/ {sub(/^# ?/, ""); print; next} {exit}' "${BASH_SOURCE[0]}"
}

# --------------------------------------------------------------- đầu ra
# --out > $D710_OUT > lỗi.  Đây là chỗ duy nhất luật đó được áp trong bash;
# phía Python nó nằm ở utils/paths.py:out_root().
resolve_out() {
    local o="${OUT:-${D710_OUT:-}}"
    [[ -n "$o" ]] || die "không biết ghi đầu ra vào đâu.
  đặt  export D710_OUT=~/UET/d710_out
  hoặc truyền  --out <thư mục>
  (cố ý không có mặc định: đầu ra không bao giờ được rơi vào cây mã)"
    o="${o/#\~/$HOME}"
    mkdir -p "$o"
    (cd "$o" && pwd)
}

need_case() { [[ -n "${CASE:-}" ]] || die "--case là bắt buộc (hoặc đặt \$D710_CASE)"; }

need_image() {
    docker image inspect "$IMAGE" >/dev/null 2>&1 || die "không có image '$IMAGE'.
  image được bàn giao nguyên con, không dựng lại:
      docker load -i d710_full.tar
  (D710/Dockerfile ghi lại image chứa gì.)"
}

# docker run với --user, để mọi file sinh ra thuộc về người chạy.  Không có nó
# thì tất cả dưới thư mục đầu ra quay về sở hữu của root.
drun() { docker run --rm -i --user "$(id -u):$(id -g)" -e HOME=/tmp "$@"; }

# beds_from <dir> <glob> <hậu tố cần bỏ> -> mảng $beds, đã sắp theo SỐ.
# Sắp theo số chứ không theo chuỗi: bed10 phải đứng sau bed9, không phải sau bed1.
beds=()
beds_from() {
    local dir="$1" pat="$2" strip="$3" p b
    beds=()
    shopt -s nullglob
    for p in "$dir"/$pat; do
        b="$(basename "$p" "$strip")"
        beds+=("${b#bed}")
    done
    shopt -u nullglob
    [[ ${#beds[@]} -gt 0 ]] || return 0
    mapfile -t beds < <(printf '%s\n' "${beds[@]}" | sort -n)
}

# SINO* nào ứng với bed n — lấy từ sidecar mà decode đã ghi, không đoán theo
# thứ tự file: số bed nằm TRONG header, và LIST0000 là bed 1.
sino_for_bed() {
    local dec="$1" n="$2"
    "$PY" - "$dec/bed$n.json" <<'PY'
import json, sys
print(json.load(open(sys.argv[1]))["path"].rsplit("/", 1)[-1])
PY
}

# ------------------------------------------------------------------ parse
CMD="${1:-}"; shift || true
case "$CMD" in ""|-h|--help|help) usage; exit $([[ -z "$CMD" ]] && echo 2 || echo 0) ;; esac

RAW=""; CT=""; LISTS=""; CASE="${D710_CASE:-}"; OUT=""; BED=""
FORCE=0; LISTMODE=0; TOF="--collapse-tof"; FORMAT=""; REST=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --raw)      RAW="$2"; shift 2 ;;
    --ct)       CT="$2"; shift 2 ;;
    --lists)    LISTS="$2"; shift 2 ;;
    --case)     CASE="$2"; shift 2 ;;
    -o|--out)   OUT="$2"; shift 2 ;;
    --bed)      BED="$2"; shift 2 ;;
    --format)   FORMAT="$2"; shift 2 ;;
    --listmode) LISTMODE=1; shift ;;
    --tof)      TOF=""; shift ;;
    --force)    FORCE=1; shift ;;
    -h|--help)  usage; exit 0 ;;
    *)          REST+=("$1"); shift ;;
  esac
done

case "$CMD" in

# --------------------------------------------------------------- decode
decode)
    need_case; need_image
    [[ -n "$RAW" ]] || die "--raw là bắt buộc"
    [[ -d "$RAW" ]] || die "không có thư mục raw: $RAW"
    O="$(resolve_out)"; DEC="$O/$CASE/decoded"
    mkdir -p "$DEC"
    RAW="$(cd "$RAW" && pwd)"

    mounts=(-v "$RAW:/raw:ro" -v "$DEC:/out" -v "$HERE/decode:/decode:ro")
    if (( LISTMODE )); then
        [[ -n "$LISTS" ]] || die "--listmode cần --lists <thư mục petLists>"
        [[ -d "$LISTS" ]] || die "không có thư mục lists: $LISTS"
        mounts+=(-v "$(cd "$LISTS" && pwd):/lists:ro")
    fi
    # KHÔNG COPY GÌ VÀO CONTAINER: raw mount read-only, mọi kết quả rơi lên
    # mount đầu ra.  Một exam là hàng chục GB.
    exec drun "${mounts[@]}" "$IMAGE" bash /decode/decode_in.sh "$LISTMODE" "$FORCE" "$TOF"
    ;;

# ------------------------------------------------------------- estimate
estimate)
    need_case; need_image
    [[ -n "$RAW" && -n "$CT" ]] || die "--raw và --ct đều bắt buộc"
    [[ -d "$RAW" ]] || die "không có thư mục raw: $RAW"
    [[ -d "$CT"  ]] || die "không có thư mục CT: $CT"
    O="$(resolve_out)"; DEC="$O/$CASE/decoded"
    [[ -d "$DEC" ]] || die "ca $CASE chưa decode; chạy: d710 decode --raw ... --case $CASE"

    if [[ -n "$BED" ]]; then beds=("$BED"); else beds_from "$DEC" 'bed*.hs' .hs; fi
    [[ ${#beds[@]} -gt 0 ]] || die "không thấy bed nào trong $DEC"

    rc=0
    for n in "${beds[@]}"; do
        VOUT="$O/$CASE/vendor/bed$n"
        if (( ! FORCE )) && [[ -f "$VOUT/normdt.f32" ]]; then
            echo "=== bed $n: đã có $VOUT -- bỏ qua"; continue
        fi
        sino="$(sino_for_bed "$DEC" "$n")"
        echo "=============== bed $n  <- $sino ==============="
        # estimate.py copy raw vào <out>/data/, nên --raw phải là file SINO*
        # thật, không phải symlink trong decoded/.
        PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" \
            "$PY" "$HERE/vendor/estimate.py" \
                --raw "$RAW/$sino" --ct "$CT" --out "$VOUT" || { rc=1; echo "  !! bed $n hỏng" >&2; }
    done
    exit "$rc"
    ;;

# --------------------------------------------------------------- tostir
tostir)
    need_case; need_image
    O="$(resolve_out)"; DEC="$O/$CASE/decoded"
    if [[ -n "$BED" ]]; then beds=("$BED"); else beds_from "$O/$CASE/vendor" 'bed*' ''; fi
    [[ ${#beds[@]} -gt 0 ]] || die "không thấy bed nào đã estimate trong $O/$CASE/vendor"

    # numpy đủ rồi, và image có sẵn -- nên bước này không cần môi trường project.
    rc=0
    for n in "${beds[@]}"; do
        echo "=============== tostir bed $n ==============="
        drun -e PYTHONPATH=/d710 \
             -v "$HERE:/d710:ro" -v "$O/$CASE:/case" "$IMAGE" \
             python3 /d710/vendor/to_stir.py \
                --vendor "/case/vendor/bed$n" \
                --template "/case/decoded/bed$n.hs" \
                --out "/case/work/bed$n" || { rc=1; echo "  !! bed $n hỏng" >&2; }
    done
    exit "$rc"
    ;;

# ------------------------------------------------------------------ exam
exam)
    need_case
    [[ -n "$RAW" && -n "$CT" ]] || die "--raw, --ct và --case đều bắt buộc"
    args=(--case "$CASE"); [[ -n "$OUT" ]] && args+=(--out "$OUT")
    (( FORCE )) && args+=(--force)
    echo "=============== bước 1: giải mã mọi bed ==============="
    "$HERE/d710" decode "${args[@]}" --raw "$RAW"
    echo
    echo "=============== bước 2: kernel của GE ==============="
    "$HERE/d710" estimate "${args[@]}" --raw "$RAW" --ct "$CT"
    echo
    echo "=============== bước 3: -> Interfile STIR ==============="
    "$HERE/d710" tostir "${args[@]}"
    echo
    echo "xong.  tiếp:  d710 osem --case $CASE"
    ;;

# ------------------------------------------------------------------ osem
osem)
    need_case
    O="$(resolve_out)"
    exec env D710_OUT="$O" PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" \
        "$PY" -m osem --case "$CASE" \
        ${BED:+--beds "$BED"} ${CT:+--ct "$CT"} "${REST[@]+"${REST[@]}"}"
    ;;

# ---------------------------------------------------------------- export
export)
    need_case
    O="$(resolve_out)"
    exec env D710_OUT="$O" PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" \
        "$PY" -m utils.export --case "$CASE" \
        ${FORMAT:+--format "$FORMAT"} "${REST[@]+"${REST[@]}"}"
    ;;

# ------------------------------------------------------------------ read
read)
    need_image
    [[ ${#REST[@]} -gt 0 ]] || die "cần một file, ví dụ: d710 read \$D710_OUT/ped/vendor/bed6/scatter.f32"
    f="$(cd "$(dirname "${REST[0]}")" && pwd)/$(basename "${REST[0]}")"
    exec drun -v "$(dirname "$f"):/data:ro" -v "$HERE:/d710:ro" "$IMAGE" \
        python3 /d710/vendor/read_out.py "/data/$(basename "$f")" "${REST[@]:1}"
    ;;

# ----------------------------------------------------------------- shell
shell)
    need_image
    mounts=(-v "$HERE:/d710:ro" -v "$HERE/vendor:/vendor:ro")
    if [[ -n "$CASE" ]]; then
        O="$(resolve_out)"; mkdir -p "$O/$CASE"
        mounts+=(-v "$O/$CASE:/case")
        echo ">> ca $CASE mount ở /case" >&2
    fi
    exec docker run --rm -it --user "$(id -u):$(id -g)" -e HOME=/tmp \
        -e PYTHONPATH=/opt/custom_tool:/d710 \
        --cap-add=SYS_PTRACE --security-opt seccomp=unconfined \
        --add-host CT85_OC0:127.0.0.1 --add-host CT85_OC1:127.0.0.1 \
        --add-host loghost:127.0.0.1  --add-host bay85ct:127.0.0.1 \
        --add-host bay87ct:127.0.0.1  --add-host trec:127.0.0.1 \
        "${mounts[@]}" "$IMAGE" bash
    ;;

*)
    echo "lệnh không biết: $CMD" >&2; echo >&2; usage >&2; exit 2 ;;
esac
