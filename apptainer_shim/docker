#!/usr/bin/env bash
set -euo pipefail

self="docker(apptainer shim)"
die() { echo "$self: $*" >&2; exit 1; }

APPTAINER="${D710_APPTAINER_BIN:-}"
if [[ -z "$APPTAINER" ]]; then
    for c in apptainer singularity; do
        if command -v "$c" >/dev/null 2>&1; then APPTAINER="$c"; break; fi
    done
fi
[[ -n "$APPTAINER" ]] || die "neither apptainer nor singularity is on \$PATH.
  This shim is only reachable through d710_apptainer / d710_isolate_stir_apptainer.sh,
  so seeing this means one of two things:
    - apptainer is not installed on this machine, or
    - you are inside a container that has this shim bound in as /usr/bin/docker
      (d710_isolate_stir.sh does that for \`export\`) -- nested apptainer does
      not work.  Harmless: the only caller is utils/quant.py reading the WCC
      factor, which it needs only for beds estimated before that factor was
      written into estimate.json.  Pass D710_K instead."

resolve_image() {
    local img="${1:-}"
    [[ -n "$img" ]] || die "no image given"
    if [[ -f "$img" ]]; then
        printf '%s/%s\n' "$(cd "$(dirname "$img")" && pwd)" "$(basename "$img")"
        return 0
    fi
    die "'$img' is not a file.
  Under apptainer the image name IS the .sif path, and the wrappers export it:
      export D710_SIF=/path/to/d710_full.sif
      export D710_SIRF_SIF=/path/to/sirf_local.sif
  (or put them in D710/.env).  Getting '$img' here means the wrapper was
  bypassed -- run  ./d710_apptainer ...  not  ./d710 ..."
}

sub="${1:-}"; shift || true
case "$sub" in
    run) : ;;
    image)
        [[ "${1:-}" == inspect ]] || die "unsupported: docker image ${*:-}"
        shift
        for i in "$@"; do
            [[ "$i" == -* ]] && continue
            resolve_image "$i" >/dev/null
            exit 0
        done
        die "docker image inspect: no image named"
        ;;
    images)
        printf 'REPOSITORY (apptainer: these are .sif files)\n'
        printf '%s\n' "${D710_IMAGE:-}" "${D710_SIRF_IMAGE:-}"
        exit 0
        ;;
    *) die "unsupported docker subcommand '${sub:-<none>}'.
  This shim covers exactly what D710/ uses: run, image inspect, images." ;;
esac

BINDS=(); ENVS=(); HOSTS=(); WORKDIR=""; ENTRY=""; IMAGE=""; CMD=(); HOME_DIR=""
HAVE_USER=0; HAVE_HOME=0; WANT_OUT_PWD=0

add_bind() {
    local b="$1" dst
    [[ "$b" == *:* ]] || die "-v $b: anonymous volumes are not supported"
    dst="${b#*:}"; dst="${dst%%:*}"
    if [[ "$dst" == /var/run/docker.sock || "$dst" == /run/docker.sock ]]; then
        return 0
    fi
    BINDS+=(--bind "$b")
    [[ "$dst" == /out ]] && WANT_OUT_PWD=1
    return 0
}

while [[ $# -gt 0 ]]; do
    arg="$1"; v=""; inline=0
    if [[ "$arg" == --*=* ]]; then v="${arg#*=}"; arg="${arg%%=*}"; inline=1; fi
    case "$arg" in
        -v|--volume)   (( inline )) || { v="${2:-}"; shift; }; add_bind "$v" ;;
        -e|--env)      (( inline )) || { v="${2:-}"; shift; }
                       case "$v" in
                           HOME=*) HOME_DIR="${v#HOME=}"; HAVE_HOME=1 ;;
                           *)      ENVS+=(--env "$v") ;;
                       esac ;;
        -w|--workdir)  (( inline )) || { v="${2:-}"; shift; }; WORKDIR="$v" ;;
        --entrypoint)  (( inline )) || { v="${2:-}"; shift; }; ENTRY="$v" ;;
        --add-host)    (( inline )) || { v="${2:-}"; shift; }
                       HOSTS+=("${v#*:} ${v%%:*}") ;;
        -u|--user)     (( inline )) || { v="${2:-}"; shift; }; HAVE_USER=1 ;;

        --group-add|--security-opt|--name|--network|--platform|--memory|--cpus|\
        --shm-size|--ulimit|--pid|--ipc|--label|-l|--hostname|-h|\
        --cap-add|--cap-drop|--device|--tmpfs)
                       (( inline )) || shift; : ;;

        --rm|-i|--interactive|-t|--tty|-it|-ti|-d|--detach|--init|\
        --no-healthcheck|--privileged|--read-only)
                       : ;;

        --) shift; break ;;
        -*) echo "$self: ignoring unknown docker flag $1" >&2 ;;
        *)  IMAGE="$arg"; shift; CMD=("$@"); break ;;
    esac
    shift || true
done
if [[ -z "$IMAGE" && $# -gt 0 ]]; then IMAGE="$1"; shift; CMD=("$@"); fi
[[ -n "$IMAGE" ]] || die "docker run: no image in the argument list"

SIF="$(resolve_image "$IMAGE")"

if [[ -n "$ENTRY" ]]; then CMD=("$ENTRY" ${CMD[@]+"${CMD[@]}"}); fi
[[ ${#CMD[@]} -gt 0 ]] || die "docker run: no command given.
  apptainer exec needs one; the image's CMD/ENTRYPOINT is not consulted."

OPTS=(--cleanenv)
case "${D710_APPTAINER_OVERLAY:-tmpfs}" in
    tmpfs) OPTS+=(--writable-tmpfs) ;;
    none)  : ;;
    *)     mkdir -p "$D710_APPTAINER_OVERLAY"
           OPTS+=(--overlay "$D710_APPTAINER_OVERLAY") ;;
esac

if (( ! HAVE_USER )); then
    want="${D710_APPTAINER_FAKEROOT:-auto}"
    ok=0
    case "$want" in
        1) ok=1 ;;
        0) ok=0 ;;
        *) if "$APPTAINER" exec --fakeroot "$SIF" true >/dev/null 2>&1; then ok=1; fi ;;
    esac
    if (( ok )); then
        OPTS+=(--fakeroot)
    elif [[ "$want" != 0 ]]; then
        cat >&2 <<EOF
$self: WARNING -- this run has no --user, i.e. docker would have run it as root
  (that is vendor/run.sh: pet_recon opens /usr/PET/systemConfig/cmcfg.xml
  read-write, and that file is root-owned and u+w-only in the image), but
  --fakeroot does not work on this machine.  Either give $(id -un) a line in
  /etc/subuid and /etc/subgid, or extract a writable systemConfig and bind it
  back over itself:
      mkdir -p "\$D710_OUT/.sysconfig"
      $APPTAINER exec "$SIF" tar -C /usr/PET -cf - systemConfig \\
        | tar -C "\$D710_OUT/.sysconfig" -xf -
      export D710_APPTAINER_BIND="\$D710_OUT/.sysconfig/systemConfig:/usr/PET/systemConfig"
  Continuing without it -- expect pet_recon to die before it reads a sinogram.
EOF
    fi
fi

if (( ! HAVE_HOME )); then OPTS+=(--no-home); HOME_DIR=/root; fi
CMD=(env "HOME=$HOME_DIR" "${CMD[@]}")

TMPD=""
cleanup() { [[ -n "$TMPD" ]] && rm -rf "$TMPD"; return 0; }
trap cleanup EXIT
if [[ ${#HOSTS[@]} -gt 0 ]]; then
    TMPD="$(mktemp -d)"
    cat /etc/hosts > "$TMPD/hosts" 2>/dev/null || printf '127.0.0.1 localhost\n' > "$TMPD/hosts"
    printf '%s\n' "${HOSTS[@]}" >> "$TMPD/hosts"
    BINDS+=(--bind "$TMPD/hosts:/etc/hosts")
fi

for b in ${D710_APPTAINER_BIND:-}; do BINDS+=(--bind "$b"); done

case "${D710_APPTAINER_NV:-auto}" in
    1) OPTS+=(--nv) ;;
    0) : ;;
    *) if [[ -e /dev/nvidiactl ]]; then OPTS+=(--nv); fi ;;
esac

if   [[ -n "$WORKDIR" ]];  then OPTS+=(--pwd "$WORKDIR")
elif (( WANT_OUT_PWD ));   then OPTS+=(--pwd /out)
fi

ARGV=("$APPTAINER" exec "${OPTS[@]}" ${ENVS[@]+"${ENVS[@]}"} \
      ${BINDS[@]+"${BINDS[@]}"} "$SIF" "${CMD[@]}")

[[ "${D710_APPTAINER_QUIET:-0}" == 1 ]] || printf '+ %s\n' "${ARGV[*]}" >&2

rc=0
"${ARGV[@]}" || rc=$?
exit "$rc"
