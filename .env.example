D710_IMAGE=d710:full
D710_SIRF_IMAGE=sirf-local:0.1
D710_SIRF_ENV_SH=/opt/SIRF-SuperBuild/INSTALL/bin/env_sirf.sh

# Apptainer (d710_apptainer / d710_isolate_stir_apptainer.sh).  Under apptainer
# the image name IS the .sif path, so these two replace the names above.  Build
# them where the docker images are:
#   apptainer build d710_full.sif  docker-daemon://d710:full
#   apptainer build sirf_local.sif docker-daemon://sirf-local:0.1
# Left unset, they are looked for in $D710_SIF_DIR, D710/sif/, D710/,
# $D710_OUT/sif and ~/sif.
#D710_SIF=/path/to/d710_full.sif
#D710_SIRF_SIF=/path/to/sirf_local.sif
