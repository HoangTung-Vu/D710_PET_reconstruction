#!/usr/bin/env bash
# d710 -- the SINGLE entry point of the GE Discovery 710 reconstruction pipeline.
#
#   d710 decode   --raw D --case N [--tof]         RDF -> Interfile, all beds
#   d710 estimate --raw D --ct D --case N [--bed n] [--tof]  GE kernel -> .f32
#   d710 tostir   --case N [--bed n]               .f32 -> STIR Interfile
#   d710 exam     --raw D --ct D --case N          = decode + estimate + tostir
#   d710 osem     --case N [--beds ...] [--iters]  OSEM + bed stitching
#   d710 export   --case N [--format nifti|dicom]  Bq/mL + SUV -> NIfTI/DICOM
#   d710 read     <file.f32>                       read one vendor dump
#   d710 shell    [--case N]                       shell inside the container
#
# TOF IS OFF BY DEFAULT.  Not because it does not work -- it does, and the TOF
# scatter is the vendor's own (see below) -- but because of the time COST on
# this machine:
#
#   measured 2026-08-27, ped bed 1, parallelproj, 16 cores, NO GPU
#   non-TOF                          ~2 min/bed
#   TOF 5 bins,  grid 128            9.6 min/bed
#   TOF 5 bins,  grid 328 (default)  ~48 min/bed
#   TOF 11 bins, grid 328            ~1.6 h/bed   -> 6 beds x 3 iter ~ 29 HOURS
#
# The machine has no NVIDIA GPU and parallelproj ships CPU-only here
# (`libparallelproj_c.so`, no CUDA build) -- both in the conda env and in
# `sirf-local:0.1`.  With a GPU the table above changes completely and TOF
# should become the default again.
#
#   --tof            enable TOF (decode mashing 5 bins + estimate reconMethod 3)
#   --tof-mash N     implies --tof, changes the mash factor (N must divide 55)
#   --no-tof         the default; spelled out for clarity
#
# The TOF axis was MIRRORED until 2026-08-29 -- GE's bin order written straight
# through, against STIR's signed timing positions -- so OSEM put the activity on
# the wrong half of every LOR and TOF came out worse than non-TOF.  Fixed by
# reversing it where it is written: gerdf.cli._tof_to_stir for the prompts and
# vendor/to_stir.py for the scatter weights, one change in two places.  Measured
# again afterwards with tools/tof_direction.py on ped/pedtof5 bed 1: the model
# now agrees with the data at +0.983 and the TOF centroid to 0.055 bins, exactly
# swapping the two columns of the 2026-08-27 run.
#
# ANYTHING DECODED BEFORE THAT DATE IS MIRRORED AND MUST BE DECODED AGAIN.
# Nothing else can tell: counts, file size and every invariant are identical
# either way, only the image differs.  So TOF headers now carry a `; TOF axis`
# line, and `utils.terms.load` refuses prompts that lack it -- re-run
# `d710 decode --tof --force` and then `d710 tostir` (both are seconds).
#
# Why mash 5 when enabled.  55 = 5 x 11, so there are only four choices:
# 1, 5, 11, 55.
#
#   mash  bins  RAM for OSEM  effective TOF resolution   SNR benefit retained
#      1   55        40 GB      681 ps = 102 mm                     100 %
#      5   11         8 GB      809 ps = 121 mm                      92 %
#     11    5       3.6 GB     1191 ps = 179 mm                      76 %
#
# (effective resolution = quadrature of 675 ps -- TIMING_RESOLUTION in
# sharcAp.cfg.XR -- with the bin width; SNR ~ sqrt(D/dx).)
#
# Keeping all 55 bins is NOT feasible here: OSEM needs prompts + background +
# sensitivity at the same time, float32, which is ~40 GB, and this machine has
# 30 GB.  Mashing 11 fits comfortably but its 982 ps bins are wider than the
# scanner's 675 ps, losing 24 %.  Mashing 5 loses 8 %.
#
# When ENABLED, `estimate` runs TOF too: `IgJobReq.reconMethod = 3` turns on
# `CScatterFully3dModel::m_bTOFDim`, and GE's own scatter model keeps the time
# axis -> `scatter_tof.f32`.  That is the vendor's REAL TOF scatter, not an
# improvised measured profile.  See `TOF_SCATTER_REVERSE.md`.
#
# One switch drives both decode and estimate, deliberately: TOF prompts with
# non-TOF scatter make OSEM silently fall back to an improvised profile.
#
# WHERE THE OUTPUT GOES:  --out  >  $D710_OUT  >  ERROR.
# Deliberately no default -- output must never land inside the source tree.
#
#   export D710_OUT=~/UET/d710_out
#   d710 exam --raw ~/Documents/11082026/petRDFS/NQLHQWPU/SYQGRVWD/QONDOBON \
#             --ct  ~/Documents/11082026/PESI/p1/e1/s2 --case ped
#
# The `d710:full` IMAGE is HANDED OVER AS-IS, never rebuilt:
#   docker load -i d710_full.tar
# So there is no `d710 build`. The Dockerfile here only records what the image
# contains -- rebuilding it needs the 18 GB custom_tool/petsw/ tree, which is
# not in the repo. The D710/ code is NOT baked into the image but mounted at
# run time, so code edits take effect immediately.
#
# WHERE EACH COMMAND RUNS
#   decode, tostir, read   -> in the container (only bash + docker needed)
#   estimate               -> host orchestrates with a BARE python3, every
#                             sub-step runs in the container
#   osem, export           -> host, needs the project environment (SIRF):
#                             conda activate petct_reconstruction
#
# Environment variables, all of which can also be set in `D710/.env`
# (copy `.env.example` -- they are identical -- and edit):
#   D710_OUT     root of the output tree
#   D710_IMAGE   image name (default d710:full)
#   D710_CASE    default case name for --case
#   D710_PYTHON  interpreter for osem/export (default python3)
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ------------------------------------------------------------------ .env
# `D710/.env` holds this machine's settings -- above all the image names, which
# are whatever `docker load` happened to restore them as.  $D710_ENV_FILE points
# somewhere else.  See `.env.example`.
ENV_FILE="${D710_ENV_FILE:-$HERE/.env}"
if [[ -f "$ENV_FILE" ]]; then
    while IFS='=' read -r k v; do
        k="${k#"${k%%[![:space:]]*}"}"                       # ltrim
        [[ "$k" == export[[:space:]]* ]] && k="${k#export}"
        k="${k//[[:space:]]/}"
        # Comments, blank lines and anything malformed fail this and are
        # skipped in silence: a typo must not stop a reconstruction.
        [[ "$k" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
        [[ -v "$k" ]] && continue                            # the shell wins
        v="${v%$'\r'}"; v="${v%%[[:space:]]#*}"              # CRLF, # comment
        v="${v#"${v%%[![:space:]]*}"}"                       # ltrim (KEY = val)
        v="${v%"${v##*[![:space:]]}"}"                       # rtrim
        [[ "$v" == \"*\" || "$v" == \'*\' ]] && v="${v:1:${#v}-2}"
        # docker and python both take these verbatim; neither expands a tilde.
        [[ "$v" == '~/'* ]] && v="$HOME${v:1}"
        export "$k=$v"
    done < "$ENV_FILE"
fi

IMAGE="${D710_IMAGE:-d710:full}"
PY="${D710_PYTHON:-python3}"


export D710_IMAGE="$IMAGE"

die() { echo "error: $*" >&2; exit 2; }
usage() {
    # The whole comment block at the top of the file, up to the first non-comment line.
    awk 'NR==1 {next} /^#/ {sub(/^# ?/, ""); print; next} {exit}' "${BASH_SOURCE[0]}"
}

# --------------------------------------------------------------- output
# --out > $D710_OUT > error.  This is the only place that rule is enforced in
# bash; on the Python side it lives in utils/paths.py:out_root().
resolve_out() {
    local o="${OUT:-${D710_OUT:-}}"
    [[ -n "$o" ]] || die "no idea where to write the output.
  set   export D710_OUT=~/UET/d710_out
  or pass  --out <directory>
  (deliberately no default: output must never land inside the source tree)"
    o="${o/#\~/$HOME}"
    mkdir -p "$o"
    (cd "$o" && pwd)
}

need_case() { [[ -n "${CASE:-}" ]] || die "--case is required (or set \$D710_CASE)"; }

need_image() {
    docker image inspect "$IMAGE" >/dev/null 2>&1 || die "no image '$IMAGE'.
  the image is handed over as-is, never rebuilt:
      docker load -i d710_full.tar
  (D710/Dockerfile records what the image contains.)
  it keeps whatever name the tar was saved with -- if that is not '$IMAGE',
  check \`docker images\` and put the real name in D710/.env:
      D710_IMAGE=<name:tag>
  or, for one run:  D710_IMAGE=<name:tag> d710 $CMD ..."
}

# Only `osem` and `export` need the project environment.  Check EARLY, because
# otherwise a bare `python3` walks straight into an `import numpy` deep inside a
# package and dies with a ModuleNotFoundError that says nothing.
#
# The two commands need two different things, and the difference matters:
#   osem   -> sirf.STIR, and SIRF only loads once the env is ACTIVATED (the loader
#             needs the env's LD_LIBRARY_PATH; the interpreter path is not enough)
#   export -> numpy + nibabel + pydicom, pure Python, interpreter path is enough
# Forcing `export` to activate like `osem` would be asking for too much.
need_py() {
    local mods="$1" what="$2"
    "$PY" -c "import ${mods}" 2>/dev/null && return
    # The project's conda env only has `python`, NOT `python3`, so a bare
    # `python3` is the system one -- and someone who just activated the right
    # env gets told to go activate it. Try `python` before concluding, but only
    # while PY is still the default: someone who set D710_PYTHON has chosen,
    # and must not be silently overridden.
    if [[ -z "${D710_PYTHON:-}" ]] && command -v python >/dev/null 2>&1 \
       && python -c "import ${mods}" 2>/dev/null; then
        PY=python
        return
    fi
    die "\`$PY\` cannot import: ${mods}
  ${what}
      conda activate petct_reconstruction
  or point straight at it:
      export D710_PYTHON=\$HOME/miniconda3/envs/petct_reconstruction/bin/python
  (only \`osem\` and \`export\` need it; decode/estimate/tostir run on a bare python3.)"
}

need_sirf() {
    need_py "numpy, sirf.STIR" \
        "SIRF/STIR only loads once the env is ACTIVATED -- the interpreter path
  alone is not enough, the loader needs the env's LD_LIBRARY_PATH too:"
}

need_export_py() {
    need_py "numpy, nibabel, pydicom" "The project environment is required:"
}

# docker run with --user, so every file created belongs to the caller.  Without
# it everything under the output directory ends up owned by root.
#
# It is a function, so it CANNOT `exec` -- callers let it run normally and then
# exit on its return code.  (The only exception to --user is the pet_recon path,
# see vendor/run.sh.)
drun() { docker run --rm -i --user "$(id -u):$(id -g)" -e HOME=/tmp "$@"; }

# beds_from <dir> <glob> <suffix to strip> -> array $beds, sorted NUMERICALLY.
# Numerically, not lexically: bed10 must come after bed9, not after bed1.
beds=()
beds_from() {
    local dir="$1" pat="$2" strip="$3" p b
    beds=()
    shopt -s nullglob
    for p in "$dir"/$pat; do
        b="$(basename "$p" "$strip")"
        beds+=("${b#bed}")
    done
    shopt -u nullglob
    [[ ${#beds[@]} -gt 0 ]] || return 0
    mapfile -t beds < <(printf '%s\n' "${beds[@]}" | sort -n)
}

# Which SINO* corresponds to bed n -- taken from the sidecar decode wrote, never
# guessed from file order: the bed number is IN the header, and LIST0000 is bed 1.
sino_for_bed() {
    local dec="$1" n="$2"
    "$PY" - "$dec/bed$n.json" <<'PY'
import json, sys
print(json.load(open(sys.argv[1]))["path"].rsplit("/", 1)[-1])
PY
}

# ------------------------------------------------------------------ parse
CMD="${1:-}"; shift || true
case "$CMD" in ""|-h|--help|help) usage; exit $([[ -z "$CMD" ]] && echo 2 || echo 0) ;; esac

RAW=""; CT=""; LISTS=""; CASE="${D710_CASE:-}"; OUT=""; BED=""
# TOF is OFF by default (see top of file: 29 hours vs 12 minutes for a 6-bed case).
#
# ONE switch, three derived flags, because all three steps must agree:
#   TOF       -> `gerdf convert --collapse-tof`   (decode)
#   TOF_MASH  -> `gerdf convert --tof-mash N`     (decode)
#   NO_TOF    -> `estimate.py --no-tof`           (reconMethod 2 instead of 3)
# TOF prompts with non-TOF scatter make OSEM silently fall back to an improvised
# profile; the reverse wastes the scatter's TOF axis. So they cannot be set apart.
FORCE=0; LISTMODE=0; TOF_ON=0; MASH=5; FORMAT=""; REST=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --raw)      RAW="$2"; shift 2 ;;
    --ct)       CT="$2"; shift 2 ;;
    --lists)    LISTS="$2"; shift 2 ;;
    --case)     CASE="$2"; shift 2 ;;
    -o|--out)   OUT="$2"; shift 2 ;;
    --bed)      BED="$2"; shift 2 ;;
    --format)   FORMAT="$2"; shift 2 ;;
    --listmode) LISTMODE=1; shift ;;
    --tof)      TOF_ON=1; shift ;;
    --no-tof|--collapse-tof) TOF_ON=0; shift ;;
    # --tof-mash IMPLIES --tof: asking for a mash factor while running non-TOF is
    # meaningless, and ignoring it silently is the kind of bug that only surfaces
    # after hours of reconstruction.
    --tof-mash) TOF_ON=1; MASH="$2"; shift 2 ;;
    --force)    FORCE=1; shift ;;
    -h|--help)  usage; exit 0 ;;
    *)          REST+=("$1"); shift ;;
  esac
done

# One switch -> three derived flags, derived in exactly one place.
if (( TOF_ON )); then
    TOF=""; TOF_MASH="--tof-mash $MASH"; NO_TOF=""
else
    TOF="--collapse-tof"; TOF_MASH=""; NO_TOF="--no-tof"
fi

case "$CMD" in

# --------------------------------------------------------------- decode
decode)
    need_case; need_image
    [[ -n "$RAW" ]] || die "--raw is required"
    [[ -d "$RAW" ]] || die "no such raw directory: $RAW"
    O="$(resolve_out)"; DEC="$O/$CASE/decoded"
    mkdir -p "$DEC"
    RAW="$(cd "$RAW" && pwd)"

    mounts=(-v "$RAW:/raw:ro" -v "$DEC:/out" -v "$HERE/decode:/decode:ro")
    if (( LISTMODE )); then
        [[ -n "$LISTS" ]] || die "--listmode needs --lists <petLists directory>"
        [[ -d "$LISTS" ]] || die "no such lists directory: $LISTS"
        mounts+=(-v "$(cd "$LISTS" && pwd):/lists:ro")
    fi
    # NOTHING IS COPIED INTO THE CONTAINER: raw is mounted read-only, every
    # result lands on the output mount.  One exam is tens of GB.
    drun "${mounts[@]}" "$IMAGE" bash /decode/decode_in.sh \
         "$LISTMODE" "$FORCE" "$TOF $TOF_MASH"
    exit $?
    ;;

# ------------------------------------------------------------- estimate
estimate)
    need_case; need_image
    [[ -n "$RAW" && -n "$CT" ]] || die "--raw and --ct are both required"
    [[ -d "$RAW" ]] || die "no such raw directory: $RAW"
    [[ -d "$CT"  ]] || die "no such CT directory: $CT"
    O="$(resolve_out)"; DEC="$O/$CASE/decoded"
    [[ -d "$DEC" ]] || die "case $CASE has not been decoded; run: d710 decode --raw ... --case $CASE"

    if [[ -n "$BED" ]]; then beds=("$BED"); else beds_from "$DEC" 'bed*.hs' .hs; fi
    [[ ${#beds[@]} -gt 0 ]] || die "no bed found in $DEC"

    rc=0
    for n in "${beds[@]}"; do
        VOUT="$O/$CASE/vendor/bed$n"
        if (( ! FORCE )) && [[ -f "$VOUT/normdt.f32" ]]; then
            echo "=== bed $n: $VOUT already exists -- skipping"; continue
        fi
        sino="$(sino_for_bed "$DEC" "$n")"
        echo "=============== bed $n  <- $sino ==============="
        # estimate.py copies raw into <out>/data/, so --raw must be the real
        # SINO* file, not the symlink in decoded/.
        PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" \
            "$PY" "$HERE/vendor/estimate.py" \
                --raw "$RAW/$sino" --ct "$CT" --out "$VOUT" $NO_TOF \
                || { rc=1; echo "  !! bed $n failed" >&2; }
    done
    exit "$rc"
    ;;

# --------------------------------------------------------------- tostir
tostir)
    need_case; need_image
    O="$(resolve_out)"; DEC="$O/$CASE/decoded"
    if [[ -n "$BED" ]]; then beds=("$BED"); else beds_from "$O/$CASE/vendor" 'bed*' ''; fi
    [[ ${#beds[@]} -gt 0 ]] || die "no estimated bed found in $O/$CASE/vendor"

    # numpy is enough, and the image already has it -- so this step does not need
    # the project environment.
    rc=0
    for n in "${beds[@]}"; do
        echo "=============== tostir bed $n ==============="
        drun -e PYTHONPATH=/d710 \
             -v "$HERE:/d710:ro" -v "$O/$CASE:/case" "$IMAGE" \
             python3 /d710/vendor/to_stir.py \
                --vendor "/case/vendor/bed$n" \
                --template "/case/decoded/bed$n.hs" \
                --out "/case/work/bed$n" || { rc=1; echo "  !! bed $n failed" >&2; }
    done
    exit "$rc"
    ;;

# ------------------------------------------------------------------ exam
exam)
    need_case
    [[ -n "$RAW" && -n "$CT" ]] || die "--raw, --ct and --case are all required"
    args=(--case "$CASE"); [[ -n "$OUT" ]] && args+=(--out "$OUT")
    (( FORCE )) && args+=(--force)
    # The TOF choice must reach BOTH decode AND estimate: if prompts and scatter
    # disagree, OSEM has to improvise, and no command reports an error.
    if (( TOF_ON )); then args+=(--tof-mash "$MASH"); else args+=(--no-tof); fi
    echo "=============== step 1: decode every bed ==============="
    "$HERE/d710" decode "${args[@]}" --raw "$RAW"
    echo
    echo "=============== step 2: GE's kernel ==============="
    "$HERE/d710" estimate "${args[@]}" --raw "$RAW" --ct "$CT"
    echo
    echo "=============== step 3: -> STIR Interfile ==============="
    "$HERE/d710" tostir "${args[@]}"
    echo
    echo "done.  next:  d710 osem --case $CASE"
    ;;

# ------------------------------------------------------------------ osem
osem)
    need_case; need_sirf
    O="$(resolve_out)"
    exec env D710_OUT="$O" PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" \
        "$PY" -u -m osem --case "$CASE" \
        ${BED:+--beds "$BED"} ${CT:+--ct "$CT"} "${REST[@]+"${REST[@]}"}"
    ;;

# ---------------------------------------------------------------- export
export)
    need_case; need_export_py
    O="$(resolve_out)"
    exec env D710_OUT="$O" PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" \
        "$PY" -u -m utils.export --case "$CASE" \
        ${FORMAT:+--format "$FORMAT"} "${REST[@]+"${REST[@]}"}"
    ;;

# ------------------------------------------------------------------ read
read)
    need_image
    [[ ${#REST[@]} -gt 0 ]] || die "a file is required, e.g.: d710 read \$D710_OUT/ped/vendor/bed6/scatter.f32"
    f="$(cd "$(dirname "${REST[0]}")" && pwd)/$(basename "${REST[0]}")"
    drun -v "$(dirname "$f"):/data:ro" -v "$HERE:/d710:ro" "$IMAGE" \
        python3 /d710/vendor/read_out.py "/data/$(basename "$f")" "${REST[@]:1}"
    exit $?
    ;;

# ----------------------------------------------------------------- shell
shell)
    need_image
    mounts=(-v "$HERE:/d710:ro" -v "$HERE/vendor:/vendor:ro")
    if [[ -n "$CASE" ]]; then
        O="$(resolve_out)"; mkdir -p "$O/$CASE"
        mounts+=(-v "$O/$CASE:/case")
        echo ">> case $CASE mounted at /case" >&2
    fi
    exec docker run --rm -it --user "$(id -u):$(id -g)" -e HOME=/tmp \
        -e PYTHONPATH=/opt/custom_tool:/d710 \
        --cap-add=SYS_PTRACE --security-opt seccomp=unconfined \
        --add-host CT85_OC0:127.0.0.1 --add-host CT85_OC1:127.0.0.1 \
        --add-host loghost:127.0.0.1  --add-host bay85ct:127.0.0.1 \
        --add-host bay87ct:127.0.0.1  --add-host trec:127.0.0.1 \
        "${mounts[@]}" "$IMAGE" bash
    ;;

*)
    echo "unknown command: $CMD" >&2; echo >&2; usage >&2; exit 2 ;;
esac
