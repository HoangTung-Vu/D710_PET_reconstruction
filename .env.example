D710_IMAGE=d710:full

# Apptainer (./d710_apptainer).  Under apptainer the image name IS the .sif
# path, so this replaces the name above.  Build it where the docker image is:
#   apptainer build d710_full.sif docker-daemon://d710:full
# Left unset, it is looked for in $D710_SIF_DIR, D710/sif/, D710/,
# $D710_OUT/sif and ~/sif.
#D710_SIF=/path/to/d710_full.sif

# Only `d710 osem` still needs SIRF, and only through ./d710_isolate_stir.sh
# on a machine with docker.  Leave these unset everywhere else.
#D710_SIRF_IMAGE=sirf-local:0.1
#D710_SIRF_ENV_SH=/opt/SIRF-SuperBuild/INSTALL/bin/env_sirf.sh
